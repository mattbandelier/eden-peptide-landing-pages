          <a class="button button--secondary" href="#how-it-works">How it works</a>
        </div>
      </div>
    </section>

    <section class="proof-band" aria-label="Trust points">
      <span>Clinician-guided</span>
      <span>Pharmacy-compounded</span>
      <span>Denver + Greenwood Village</span>
