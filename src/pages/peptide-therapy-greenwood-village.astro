---
import LeadForm from "@/components/LeadForm.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const canonical = "https://edenhealthclubs.com/peptide-therapy-greenwood-village/";
const title = "Peptide Therapy in Greenwood Village | Eden Health Clubs Denver";
const description =
