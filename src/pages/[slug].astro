---
import FitnessLandingPageView from "@/components/FitnessLandingPageView.astro";
import { fitnessPages, getFitnessPage } from "@/data/fitness-pages";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return fitnessPages.map((page) => ({
    params: { slug: page.slug }
  }));
}

const page = getFitnessPage(Astro.params.slug ?? "");
const canonical = new URL(`/${page?.slug ?? ""}/`, Astro.site ?? "https://landing.edenhealthclubs.com").toString();

if (!page) {
  return Astro.redirect("/");
}
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonical={canonical}
>
  <FitnessLandingPageView page={page} />
</BaseLayout>
